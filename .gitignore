# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/web-dist/
/backend/.data/
/desktop/node_modules/
/desktop/target/
target/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
!.env.example
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Local SQLite databases
/.data/

# Private keys and local credentials (example environment files stay tracked)
*.key
*.p12
*.pfx
id_rsa
id_ed25519
id_ecdsa
id_dsa

# Local databases and SQLite journal files
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-wal
*.db-shm

# Python caches and generated delivery artifacts
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
/release/
